# Copy this file to .env and fill in real values locally. Never commit .env.
# See docs/Functional Requirements Document.txt, Section 27 (Security Requirements)
# and Section 61 (Environment Configuration) for the rules governing these values.

# Database (Microsoft SQL Server) — placeholders only; real values go in backend/.env
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=false

# Backend server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Fulfilment engine flags
ALLOW_OVERALLOCATION=false
