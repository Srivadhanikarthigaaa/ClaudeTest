# Copy this file to .env and fill in real values locally. Never commit .env.
# See docs/Functional Requirements Document.txt, Section 27 (Security Requirements)
# and Section 61 (Environment Configuration) for the rules governing these values.

# Database (Microsoft SQL Server) — placeholders only; real values go in backend/.env
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=false

# Backend server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Fulfilment engine flags
ALLOW_OVERALLOCATION=false

# CHANGE1 requirement 2 — partial-release threshold for PRIORITY orders, as a
# whole-number percentage of the requested quantity. A Priority order with at
# least this much available across WH-A/WH-B/WH-C (but less than 100%) is
# Partially Released; below it, Blocked. Defaults to 70 when unset. Must be a
# number between 0 and 100 — anything else makes the backend fail loudly
# rather than silently fall back.
PARTIAL_RELEASE_THRESHOLD_PERCENT=70
